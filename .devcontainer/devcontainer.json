{
  "name": "Iris Dev Containers",
  "dockerComposeFile": "compose.yml",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:1": {}
  },
  "service": "backend",
  "workspaceFolder": "/workspaces/backend",
  "postCreateCommand": {
    "venv": "[ -d .venv ] || uv venv .venv",
    "sync": "cd /workspaces/backend && uv sync --no-dev"
  },
  "postStartCommand": "git config --global --add safe.directory /workspaces/backend",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/backend/.venv/bin/python",
        "python.languageServer": "Pylance",
        "editor.formatOnSave": true
      }
    }
  },
  "remoteUser": "vscode",
  "remoteEnv": {
    "PATH": "/workspaces/backend/.venv/bin:${containerEnv:PATH}"
  },
  "forwardPorts": [
    8000
  ]
}