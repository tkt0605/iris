{
  "name": "I.R.I.S Backend Dev Container",
  "build": {
    "dockerfile": "../backend/Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "uid": "1000",
      "gid": "1000"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "tamasfe.even-better-toml",
        "ethinvaz.z3-explorer",
        "bungcip.better-toml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/backend/.venv/bin/python"
      }
    }
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/backend",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/backend,type=bind,consistency=cached",
  "postCreateCommand": "sudo chown -R vscode:vscode /workspaces/backend && [ -d .venv ] || uv venv .venv && uv sync",
  "remoteEnv": {
    "PATH": "/workspaces/backend/.venv/bin:${containerEnv:PATH}"
  },
  "forwardPorts": [8000]
}